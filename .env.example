# NOVA AI - Firebase configuration
#
# 1. Copy this file to ".env" in the project root (same folder as package.json).
# 2. In the Firebase console open: Project settings > General > Your apps > Web app > SDK setup and configuration.
# 3. Paste each value from the "firebaseConfig" object next to the matching key below.
# 4. Restart "npm run dev" - Vite only reads .env when it starts.
#
# These web keys identify the project and are shipped to the browser, so they are not secrets.
# What protects the data is the Firestore Security Rules in "firestore.rules" - publish them before going live.
# Never commit your real .env file (it is already in .gitignore).

# firebaseConfig.apiKey
VITE_FIREBASE_API_KEY=

# firebaseConfig.authDomain (e.g. your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=

# firebaseConfig.projectId
VITE_FIREBASE_PROJECT_ID=

# firebaseConfig.storageBucket (e.g. your-project.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=

# firebaseConfig.messagingSenderId
VITE_FIREBASE_MESSAGING_SENDER_ID=

# firebaseConfig.appId
VITE_FIREBASE_APP_ID=

# Optional, local development only: uncomment to use the Firebase Emulator Suite
# (Auth on 127.0.0.1:9099, Firestore on 127.0.0.1:8080) instead of the live project.
# VITE_FIREBASE_USE_EMULATOR=true


# NOVA AI - Gemini API key (powers the "Nova" chatbot)
#
# 1. Create a free key at https://aistudio.google.com/apikey and paste it below.
# 2. Restart "npm run dev".
# Leave it empty and Nova still works, using her built-in basic replies.
#
# IMPORTANT: unlike the Firebase keys above, this key IS a secret, and every VITE_ variable is
# embedded in the website's JavaScript, so any visitor can read it and spend your quota.
# Before going live, open the key in Google Cloud Console > APIs & Services > Credentials and
#   - under "Application restrictions" choose "Websites" and add your site's address,
#   - under "API restrictions" allow only the "Generative Language API".
VITE_GEMINI_API_KEY=
