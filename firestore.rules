rules_version = '2';

// NOVA AI Firestore Security Rules.
// Publish these in the Firebase console (Firestore Database > Rules) or with `firebase deploy --only firestore:rules`.
// The admin checks in the React app only hide UI; these rules are what actually protect the data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep this list in sync with ADMIN_EMAILS in src/context/AuthContext.jsx.
    // email_verified is required so nobody can claim an admin address by signing up with a password they chose.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['omarodat012@gmail.com', 'shahla.alzawahreh33@gmail.com'];
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // True for a verified account whose address is on the members list. `member_emails` has one document per
    // member address (document ID = lowercased email); only admins can write it, so nobody can add themselves.
    function isMember() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/member_emails/$(request.auth.token.email.lower()));
    }

    function isOptionalText(value, maxLength) {
      return value == null || isText(value, maxLength);
    }

    function isValidApplication(data) {
      let fields = ['fullName', 'phone', 'email', 'isStudent', 'major', 'university', 'academicYear', 'subteam',
        'status', 'createdAt', 'submittedByUid'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isText(data.fullName, 120)
        && isText(data.phone, 30)
        && isText(data.email, 200)
        && data.isStudent is bool
        && isOptionalText(data.major, 120)
        && isOptionalText(data.university, 120)
        && isOptionalText(data.academicYear, 30)
        && data.subteam in ['projects', 'operations', 'media', 'partnerships', 'education']
        && data.status == 'pending'
        && data.createdAt == request.time
        && (data.submittedByUid == null || (signedIn() && data.submittedByUid == request.auth.uid));
    }

    // True when the signed-in account owns this `members` document: its address is verified and matches the
    // document's email. `emailLower` is what admin writes store; older documents only have `email`.
    // The app's lookup queries in src/services/membersService.js filter on exactly these fields.
    function ownsMember(data) {
      return signedIn()
        && request.auth.token.email_verified == true
        && (data.emailLower == request.auth.token.email.lower()
          || data.email == request.auth.token.email
          || data.email == request.auth.token.email.lower());
    }

    // Profile photos are small images resized in the browser and stored inline as a data URL.
    function isValidPhoto(value) {
      return value == null
        || (value is string
          && value.size() <= 100000
          && value.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }

    function isValidOwnProfile(data) {
      return isText(data.fullName, 120)
        && isOptionalText(data.get('phone', null), 30)
        && data.get('isStudent', false) is bool
        && isOptionalText(data.get('major', null), 120)
        && isOptionalText(data.get('university', null), 120)
        && isOptionalText(data.get('academicYear', null), 30)
        && isValidPhoto(data.get('photoURL', null))
        && data.updatedAt == request.time;
    }

    // NOVA AI's single Faculty Supervisor, recognized by her verified address even before an admin adds her to
    // `members`. Keep the address in sync with SUPERVISOR_EMAIL in src/data/memberRoles.js.
    function isSupervisor() {
      return hasVerifiedEmail() && request.auth.token.email.lower() == 'enas.a@yu.edu.jo';
    }

    // The one document the supervisor may create herself: her own profile, with the role, address and SubTeam fixed.
    function isValidSupervisorProfile(data) {
      let fields = ['fullName', 'phone', 'photoURL', 'email', 'emailLower', 'role', 'subteam', 'isStudent', 'major',
        'university', 'academicYear', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isValidOwnProfile(data)
        && data.email == request.auth.token.email.lower()
        && data.emailLower == request.auth.token.email.lower()
        && data.role == 'supervisor'
        && data.subteam == null
        && data.createdAt == request.time;
    }

    // Each signed-in user creates their own profile once, on first login, and may rename themselves afterwards.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && isText(request.resource.data.displayName, 80)
        && request.resource.data.updatedAt == request.time;
    }

    // True when the address already has a `member_emails` entry (document ID = lowercased email).
    // An address with a slash can never be such an ID, and would not form a valid path here.
    function isMemberEmail(email) {
      return !email.matches('.*/.*')
        && exists(/databases/$(database)/documents/member_emails/$(email.trim().lower()));
    }

    // Anyone can submit an application, except with an address that is already a member's.
    // Only admins can read or manage them.
    match /applications/{applicationId} {
      allow create: if isValidApplication(request.resource.data) && !isMemberEmail(request.resource.data.email);
      allow read, update, delete: if isAdmin();
    }

    // Admins manage every member. A member can read their own document and change only their profile fields;
    // role, subteam, email and emailLower stay under admin control, and members cannot create or delete documents.
    // Verified NOVA AI members can also read the other members, which is what the SubTeam rosters are built from.
    // Guests and accounts that are not members cannot read anyone.
    // The Faculty Supervisor reads the rosters like a member, and may create members/supervisor (her own profile)
    // when no admin has added her yet; after that the same self-update limits apply to her as to any member.
    match /members/{memberId} {
      allow read: if isAdmin() || ownsMember(resource.data) || isMember() || isSupervisor();
      allow update: if isAdmin()
        || (ownsMember(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['fullName', 'phone', 'isStudent', 'major', 'university', 'academicYear', 'photoURL', 'updatedAt'])
          && isValidOwnProfile(request.resource.data));
      allow create: if isAdmin()
        || (isSupervisor() && memberId == 'supervisor' && isValidSupervisorProfile(request.resource.data));
      allow delete: if isAdmin();
    }

    // The public team strip on the home page: one card per member (document ID = member ID) with a name, photo,
    // role and SubTeam only, so guests never touch `members`. The app keeps it in sync from the admin dashboard.
    // The Faculty Supervisor is never listed. A member may change the name and photo of their own card, nothing else;
    // ownership is checked against the email on their `members` document.
    function isValidPublicMember(data) {
      return data.keys().hasOnly(['name', 'photoURL', 'role', 'roleTier', 'subteam', 'updatedAt'])
        && isText(data.name, 120)
        && isValidPhoto(data.get('photoURL', null))
        && isText(data.role, 60)
        && data.role != 'supervisor'
        && data.roleTier in ['leader', 'member']
        && isOptionalText(data.get('subteam', null), 60)
        && data.updatedAt == request.time;
    }

    match /public_members/{memberId} {
      allow read: if true;
      allow create: if isAdmin() && memberId != 'supervisor' && isValidPublicMember(request.resource.data);
      allow update: if (isAdmin() && isValidPublicMember(request.resource.data))
        || (ownsMember(get(/databases/$(database)/documents/members/$(memberId)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt'])
          && isValidPublicMember(request.resource.data));
      allow delete: if isAdmin();
    }

    // The members lookup behind isMember(). The app keeps it in sync with `members` from the admin dashboard.
    // Anyone may check one exact address (the Join form does, before submitting); only admins can list or write,
    // so the addresses cannot be browsed or scraped.
    match /member_emails/{emailLower} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // What members see on the SubTeam rosters: one switch per SubTeam plus the "show member details" switch.
    match /settings/rosterVisibility {
      allow read: if hasVerifiedEmail();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['showRoster', 'showMemberDetails', 'updatedAt'])
        && request.resource.data.showRoster is map
        && request.resource.data.showRoster.keys().hasOnly(['projects', 'operations', 'media', 'partnerships', 'education'])
        && request.resource.data.showMemberDetails is bool;
      allow delete: if isAdmin();
    }

    // The live "NOVA Status" story on the home page: public to read, written by admins only.
    // imageData is a compressed image stored inline as a data URL (about 150 KB at most).
    function isValidNovaStatus(data) {
      let fields = ['active', 'title', 'message', 'imageData', 'updatedAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.active is bool
        && data.title is string
        && data.title.size() <= 150
        && data.message is string
        && data.message.size() <= 1000
        && (data.imageData == null
          || (data.imageData is string
            && data.imageData.size() <= 210000
            && data.imageData.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+')))
        && data.updatedAt == request.time;
    }

    match /settings/novaStatus {
      allow read: if true;
      allow create, update: if isAdmin() && isValidNovaStatus(request.resource.data);
      allow delete: if isAdmin();
    }

    // Achievements are shown publicly on the home page.
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SubTeam leaders are shown publicly on the home page and the SubTeam pages.
    // One document per SubTeam (document ID = subteam ID), holding the `leaders` list that admins manage.
    match /subteam_leaders/{subteamId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && subteamId in ['projects', 'operations', 'media', 'partnerships', 'education']
        && request.resource.data.keys().hasOnly(['leaders', 'updatedAt'])
        && request.resource.data.leaders is list
        && request.resource.data.leaders.size() <= 20;
      allow delete: if isAdmin();
    }

    // Any signed-in account can send feedback under its own uid; only admins can read, review or delete it.
    function isValidFeedback(data) {
      let fields = ['uid', 'userName', 'userEmail', 'isMember', 'category', 'message', 'status', 'createdAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.uid == request.auth.uid
        && isOptionalText(data.userName, 120)
        && (data.userEmail == null || data.userEmail == request.auth.token.email)
        && data.isMember is bool
        && data.category in ['suggestion', 'opinion', 'event', 'other']
        && isText(data.message, 3000)
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() && isValidFeedback(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['new', 'reviewed'];
    }
  }
}
